{
  "name": "math-dreamweaver-javascript-cas",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "description": "Offline Calculus I tutor with fair student-typed grading, flexible first rules, domain awareness and mistake feedback",
  "scripts": {
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "build:offline": "node scripts/build-offline.cjs",
    "build:steps": "esbuild lib/step-engine.mjs --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=offline/vendor/step-engine.bundle.js",
    "test:browser": "node test/browser-smoke.cjs",
    "test:render": "node test/render-check.browser.cjs",
    "traces": "node scripts/print-derivative-traces.mjs",
    "audit:rules": "node scripts/audit-derivative-rules.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "nerdamer": "2.0.0",
    "mathjax": "3.2.2",
    "@cortex-js/compute-engine": "0.159.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1"
  }
}
